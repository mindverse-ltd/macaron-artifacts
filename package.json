{
  "name": "macaron-artifacts",
  "version": "0.1.0",
  "description": "One local WebUI for coding harnesses and streaming UI4A artifacts.",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @macaron/artifacts dev",
    "build": "pnpm --filter @macaron/artifacts build",
    "build:web:legacy": "pnpm --filter @macaron/shared build && pnpm --filter @macaron/web build",
    "build:server:legacy": "pnpm --filter @macaron/shared build && pnpm --filter @macaron/server build",
    "start": "pnpm --filter @macaron/artifacts start",
    "bundle:legacy": "pnpm --filter @macaron/server bundle",
    "prepack": "pnpm build",
    "typecheck": "pnpm --filter @macaron/artifacts typecheck",
    "replay:test": "node --test scripts/replay/*.test.mjs",
    "replay:render": "pnpm build:web:legacy && node scripts/replay/render.mjs",
    "dev:legacy": "concurrently -k -n server,web -c blue,magenta \"pnpm --filter @macaron/server dev\" \"pnpm --filter @macaron/web dev\"",
    "build:legacy": "pnpm --filter @macaron/shared build && pnpm --filter @macaron/server build && pnpm --filter @macaron/web build",
    "start:legacy": "node server/dist/index.js",
    "typecheck:legacy": "pnpm --filter @macaron/shared typecheck && pnpm --filter @macaron/server typecheck && pnpm --filter @macaron/web typecheck",
    "test": "pnpm --filter @macaron/artifacts test",
    "test:package": "node --test scripts/package.test.mjs"
  },
  "bin": {
    "macaron-artifacts": "./bin/macaron-artifacts.mjs"
  },
  "files": [
    "bin/macaron-artifacts.mjs",
    "README.md",
    "artifacts/dist",
    "artifacts/skills"
  ],
  "engines": {
    "node": ">=22.19"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12",
      "onFail": "warn"
    }
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.263",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@opencode-ai/sdk": "1.18.29",
    "ai": "7.0.93",
    "partial-json": "0.1.7"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "pkg-pr-new": "^0.0.75",
    "playwright-core": "^1.61.1",
    "typescript": "^5.7.0",
    "unocss": "66.8.1"
  }
}
